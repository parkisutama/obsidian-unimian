{
	"$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
	"include-v-in-tag": false,
	"include-component-in-tag": false,
	"bump-minor-pre-major": true,
	"bump-patch-for-minor-pre-major": true,
	"pull-request-title-pattern": "chore: release ${version}",
	"changelog-sections": [
		{
			"type": "feat",
			"section": "Added"
		},
		{
			"type": "fix",
			"section": "Fixed"
		},
		{
			"type": "perf",
			"section": "Changed"
		},
		{
			"type": "refactor",
			"section": "Changed",
			"hidden": true
		},
		{
			"type": "revert",
			"section": "Removed"
		},
		{
			"type": "docs",
			"section": "Documentation",
			"hidden": true
		},
		{
			"type": "test",
			"section": "Tests",
			"hidden": true
		},
		{
			"type": "build",
			"section": "Build",
			"hidden": true
		},
		{
			"type": "ci",
			"section": "CI",
			"hidden": true
		},
		{
			"type": "chore",
			"section": "Chores",
			"hidden": true
		}
	],
	"packages": {
		".": {
			"release-type": "node",
			"package-name": "obsidian-unimian",
			"changelog-path": "CHANGELOG.md",
			"extra-files": [
				{
					"type": "json",
					"path": "manifest.json",
					"jsonpath": "$.version"
				}
			]
		}
	},
	"bootstrap-sha": "262887018e3053e2c89d49e9e2f1ad2d1d633e5f"
}
